data("CigarettesSW")
head(CigarettesSW)
summary(CigarettesSW)
?CigarettesSW
cig95 <- CigarettesSW[CigarettesSW$year == "1995",]
plot(packs ~ price, data=cig95,
ylab="Packs Purchased per Capita", xlab="Average Price of Cigarettes")
summary(lm(packs ~ price, data=cig95))
cig95$salestax <- cig95$taxs - cig95$tax
summary(cig95$salestax )
m1 <- lm(log(price) ~ salestax, data = cig95)
summary(m1)
# fancy standard errors that economists like
hc1 <- function(x) vcovHC(x, type = "HC1")
coeftest(m1, vcov = hc1)
cig95$pred_log_adj_price <- m1$fitted.values
m1$fitted.values
m2 <- lm(log(packs) ~ pred_log_adj_price, data=cig95)
summary(m2)
coeftest(m2, vcov = hc1) # we so fancy!
